+//go:build !linux || !arm64 || purego
+
+package aes
+
+type eip93CBCState struct{}
+
+func newEIP93CBCState(b *Block) *eip93CBCState { return nil }
+func (*eip93CBCState) crypt(b *Block, iv *[BlockSize]byte, dst, src []byte, decrypt bool) bool {
+	return false
+}
