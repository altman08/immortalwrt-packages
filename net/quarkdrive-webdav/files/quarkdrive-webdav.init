#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

CONF="quarkdrive-webdav"
PROG="/usr/bin/quarkdrive-webdav"

is_enabled() {
	local enabled
	config_get_bool enabled "$1" "$2" "${3:-0}"
	[ "$enabled" -eq 1 ]
}

append_arg() {
	local value
	config_get value "config" "$2" "$3"
	[ -n "$value" ] && procd_append_param command "$1" "$value"
}

append_bool() {
	is_enabled "config" "$2" "$3" && procd_append_param command "$1"
}

start_service() {
	local quark_cookie auth_user auth_password

	config_load "$CONF"
	is_enabled "config" "enabled" || return 1

	config_get quark_cookie "config" "quark_cookie"
	[ -n "$quark_cookie" ] || {
		logger -t "$CONF" "QUARK_COOKIE is not configured"
		return 1
	}

	procd_open_instance "$CONF"
	procd_set_param command "$PROG"
	procd_set_param file "/etc/config/$CONF"
	procd_set_param env QUARK_COOKIE="$quark_cookie"

	config_get auth_user "config" "auth_user"
	config_get auth_password "config" "auth_password"
	[ -n "$auth_user" ] && procd_append_param env WEBDAV_AUTH_USER="$auth_user"
	[ -n "$auth_password" ] && procd_append_param env WEBDAV_AUTH_PASSWORD="$auth_password"

	append_arg --host host "0.0.0.0"
	append_arg --port port "8080"
	append_arg --root root "/"
	append_arg --read-buffer-size read_buffer_size "10485760"
	append_arg --upload-buffer-size upload_buffer_size "16777216"
	append_arg --cache-size cache_size "1000"
	append_arg --cache-ttl cache_ttl "600"
	append_arg --refresh-cache-secs-interval refresh_cache_secs_interval "300"
	append_arg --upload-wait-timeout upload_wait_timeout "280"
	append_arg --tls-cert tls_cert
	append_arg --tls-key tls_key
	append_arg --strip-prefix strip_prefix

	append_bool --auto-index auto_index
	append_bool --no-trash no_trash
	append_bool --read-only read_only
	append_bool --debug debug
	append_bool --no-self-upgrade no_self_upgrade "1"
	append_bool --skip-upload-same-size skip_upload_same_size
	append_bool --prefer-http-download prefer_http_download
	append_bool --redirect redirect

	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
